<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=" ESP OVERLAY"
            android:textColor="#FF00FFFF"
            android:textSize="13dp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/esp_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" ESP LINE"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/esp_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" ESP BOX"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/esp_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" ESP SKELETON"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/esp_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" ESP HEALTH"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/esp_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" ESP NAME"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/esp_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" ESP DISTANCE"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/esp_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" ESP COUNT"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
