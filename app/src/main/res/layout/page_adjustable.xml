<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/_drawer_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/olok4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:text="ADJUSTABLE FEATURE"
                            android:textColor="#FF00FFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/_drawer_header2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="0dp">

                                <!-- AIMBOT -->
                                <TextView
                                    android:id="@+id/aimbot_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="AIMBOT (0%)"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="12sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="5dp"
                                    android:orientation="vertical" />

                                <SeekBar
                                    android:id="@+id/aimbot_seekbar"
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    android:max="100"
                                    android:progress="0"
                                    style="@style/SeekBar.Custom" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="5dp"
                                    android:orientation="vertical" />

                                <!-- SNOWBOARD -->
                                <TextView
                                    android:id="@+id/snowboard_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="SNOWBOARD (0%)"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="12sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="5dp"
                                    android:orientation="vertical" />

                                <SeekBar
                                    android:id="@+id/snowboard_seekbar"
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    android:max="100"
                                    android:progress="0"
                                    style="@style/SeekBar.Custom" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="5dp"
                                    android:orientation="vertical" />

                                <!-- MP VIEW -->
                                <TextView
                                    android:id="@+id/mp_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="MP VIEW (0%)"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="12sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="5dp"
                                    android:orientation="vertical" />

                                <SeekBar
                                    android:id="@+id/mp_seekbar"
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    android:max="100"
                                    android:progress="0"
                                    style="@style/SeekBar.Custom" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="5dp"
                                    android:orientation="vertical" />

                                <!-- BR IPAD VIEW -->
                                <TextView
                                    android:id="@+id/br_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="BR IPAD VIEW (0%)"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="12sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="5dp"
                                    android:orientation="vertical" />

                                <SeekBar
                                    android:id="@+id/br_seekbar"
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    android:max="100"
                                    android:progress="0"
                                    style="@style/SeekBar.Custom" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="5dp"
                                    android:orientation="vertical" />

                                <!-- FAST DIVED -->
                                <TextView
                                    android:id="@+id/diveb_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="FAST DIVED (0%)"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="12sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="5dp"
                                    android:orientation="vertical" />

                                <SeekBar
                                    android:id="@+id/diveb_seekbar"
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    android:max="100"
                                    android:progress="0"
                                    style="@style/SeekBar.Custom" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
    </ScrollView>
</LinearLayout>