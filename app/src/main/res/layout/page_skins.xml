<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/_drawer_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp"
                                android:gravity="center"
                                android:text=" SKIN HACKS"
                                android:textColor="#FF00FFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/un"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="BLUEPRINT"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Cammo hacks"
                                android:textColor="#FFFF0000"
                                android:textSize="15sp" />

                            <RadioGroup
                                android:id="@+id/camo_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <RadioButton
                                    android:id="@+id/offcamo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="OFFCAMO"
                                    android:textColor="#FFF9FFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/diamond"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="DIAMOND CAMMO"
                                    android:textColor="#FFF9FFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/redsprite"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="REDSPRITE CAMMO"
                                    android:textColor="#FFF9FFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/emerald"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="EMERALD CAMMO"
                                    android:textColor="#FFF9FFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/assault"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="ASSAULTE CAMMO"
                                    android:textColor="#FFF9FFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/scorch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="SCORCH CAMMO"
                                    android:textColor="#FFF9FFFF"
                                    android:textSize="15sp" />
                            </RadioGroup>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="GUN HACKS"
                                android:textColor="#FFFF0000"
                                android:textSize="15sp" />

                            <RadioGroup
                                android:id="@+id/gun_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <RadioButton
                                    android:id="@+id/ak117"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="AK117 MOMENTO MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/bp50"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="BP50 MYTHIC"
                                    android:textColor="#FFF9FFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/ffar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="FFAR MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/grau"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="GRAU MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/krig6"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="KRIG6 ICE MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/type19"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="TYPE 19 CELESTIAL MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/dlq"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="DLQ MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/jak"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="JACK MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/lucos"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="LUCOS MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />
                            </RadioGroup>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="[L] GUNS"
                                android:textColor="#FFFF0000"
                                android:textSize="15sp" />

                            <RadioGroup
                                android:id="@+id/guns2_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <RadioButton
                                    android:id="@+id/fennec"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="FENNEC MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/mg40"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="MG40 MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/qq9"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="QQ9 MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/m13"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="M13 MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />

                                <RadioButton
                                    android:id="@+id/x9"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="SWITCH BLADE MYTHIC"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="15sp" />
                            </RadioGroup>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>