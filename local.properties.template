sdk.dir=/path/to/android/sdk

# Release signing (optional). If these are absent, the release build type falls
# back to the debug keystore so the APK is always signed and installable.
# storeFile may be absolute or relative to the project root (e.g. keystore.jks).
# In CI, the same values can be provided via STORE_FILE / STORE_PASSWORD /
# KEY_ALIAS / KEY_PASSWORD environment variables instead.
#storeFile=keystore.jks
#storePassword=your_keystore_password
#keyAlias=taizou
#keyPassword=your_key_password
